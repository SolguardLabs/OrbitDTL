{
  "name": "orbit-dtl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pruebas de integracion para Orbit DTL",
  "scripts": {
    "test": "bun test --timeout 30000 ./tests/node",
    "test:rust": "cargo test --locked",
    "test:all": "cargo test --locked && bun test --timeout 30000 ./tests/node",
    "ci": "bash scripts/ci.sh",
    "ci:local": "bash scripts/ci.sh",
    "tests:script": "bash scripts/tests.sh",
    "build": "bun scripts/check-js.mjs",
    "fmt": "prettier --write --config .prettierrc --ignore-path .prettierignore \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "fmt:check": "prettier --check --config .prettierrc --ignore-path .prettierignore \"tests/**/*.js\" \"scripts/**/*.mjs\""
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
